{
  "manifest_version": 3,
  "name": "Glyph for Gmail",
  "version": "0.3.1",
  "description": "Add a tracking glyph and tracked links to Gmail's own compose window.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "scripting", "alarms", "notifications"],
  "optional_host_permissions": ["https://*/*"],
  "host_permissions": ["https://mail.google.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Glyph for Gmail"
  },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["messaging.js", "gmail.js"],
      "css": ["gmail.css"],
      "run_at": "document_idle"
    }
  ]
}
