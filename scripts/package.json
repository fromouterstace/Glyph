{
  "name": "@workspace/scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node run-unit-tests.mjs",
    "test:contracts": "tsx --test test-gmail-extension.mjs test-gmail-background.mjs tracking-origin.contract.test.mjs monitoring.contract.test.mjs casing.contract.test.mjs web-serving.contract.test.mjs",
    "test:gates": "node --test quality-gates.integration.test.mjs",
    "test:integration": "GLYPH_DATABASE_TESTS=1 tsx --test database.integration.test.mjs && pnpm test:services && pnpm test:process",
    "test:process": "GLYPH_DATABASE_TESTS=1 tsx --test server-process.integration.test.mjs",
    "test:services": "GLYPH_DATABASE_TESTS=1 vitest run --config vitest.integration.config.mts",
    "test:native-verification": "tsx --test test-native-verification.mjs",
    "test:reply-matching": "tsx --test test-reply-matching.mjs",
    "test:tracking-pixel": "tsx --test test-tracking-pixel.mjs",
    "test:tracking-http": "node --test test-tracking-http.mjs",
    "test:gmail-extension": "tsx --test test-gmail-extension.mjs test-gmail-background.mjs",
    "hello": "tsx ./src/hello.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@sinonjs/fake-timers": "^15.4.0",
    "@types/node": "catalog:",
    "@workspace/db": "workspace:*",
    "express": "^5.3.0",
    "jsdom": "^30.1.3",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "tsx": "catalog:",
    "vitest": "^5.1.0"
  }
}
