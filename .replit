modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[[deployment.responseHeaders]]
path = "/*"
name = "Content-Security-Policy"
value = "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"

[[deployment.responseHeaders]]
path = "/*"
name = "Referrer-Policy"
value = "strict-origin-when-cross-origin"

[[deployment.responseHeaders]]
path = "/*"
name = "Permissions-Policy"
value = "camera=(), microphone=(), geolocation=()"

[[deployment.responseHeaders]]
path = "/*"
name = "X-Content-Type-Options"
value = "nosniff"

[[deployment.responseHeaders]]
path = "/*"
name = "X-Frame-Options"
value = "DENY"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "quality"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "database-contracts"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "http-contracts"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "release"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "composer"

[[workflows.workflow]]
name = "quality"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm check"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "database-contracts"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm check:integration"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "http-contracts"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm check:http"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "release"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm check:all && PORT=3000 BASE_PATH=/ pnpm -r --if-present run build:artifact"

[[workflows.workflow]]
name = "composer"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm check:composer && pnpm --filter @workspace/glyph test"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
GLYPH_ADMIN_EMAILS = "glyph.test.email@gmail.com"
GLYPH_GMAIL_OAUTH_ORIGIN = "https://glyph.rocks"

[objectStorage]
defaultBucketID = "replit-objstore-f95b1e64-65bc-4eb1-bf81-b16e9ae9b796"
