modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "quality"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "database-contracts"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "http-contracts"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "release"

[[workflows.workflow]]
name = "quality"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm check"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "database-contracts"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm check:integration"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "http-contracts"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm check:http"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "release"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm check:all && PORT=3000 BASE_PATH=/ pnpm -r --if-present run build:artifact"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
