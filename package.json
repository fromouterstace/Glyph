{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm --filter @workspace/scripts test && pnpm --filter @workspace/scripts test:contracts && pnpm --filter @workspace/glyph test",
    "check": "pnpm check:database && pnpm lint && pnpm format:check && pnpm typecheck && pnpm check:composer && pnpm test && pnpm check:gates",
    "check:database": "node scripts/check-database-safety.mjs",
    "check:composer": "node scripts/check-composer-tests.mjs",
    "check:gates": "pnpm --filter @workspace/scripts test:gates",
    "check:integration": "pnpm --filter @workspace/scripts test:integration",
    "check:http": "pnpm --filter @workspace/scripts test:tracking-http",
    "check:smoke": "node scripts/smoke-check.mjs",
    "check:published": "node scripts/published-smoke.mjs",
    "release:regressions": "node scripts/release-regression.mjs report",
    "release:record": "node scripts/release-regression.mjs record",
    "release:observe": "node scripts/release-regression.mjs observe",
    "check:all": "pnpm check && pnpm check:integration && pnpm check:http && pnpm check:smoke",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check \"{artifacts,lib,scripts,extensions}/**/*.{ts,tsx,js,mjs,json,css,yaml,yml}\" \"*.{json,mjs,yaml}\" \".github/**/*.yml\"",
    "format": "prettier --write \"{artifacts,lib,scripts,extensions}/**/*.{ts,tsx,js,mjs,json,css,yaml,yml}\" \"*.{json,mjs,yaml}\" \".github/**/*.yml\"",
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm check && pnpm -r --if-present run build:artifact",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
